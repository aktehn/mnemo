{
  "name": "mnemo-desktop",
  "private": false,
  "version": "1.0.0",
  "description": "Mnemo - Master Your Vocabulary with Spaced Repetition",
  "type": "module",
  "author": {
    "name": "Aykut Dağ",
    "email": "aykut.dag@proton.me",
    "url": "https://github.com/aktehn"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aktehn/mnemo"
  },
  "bugs": {
    "url": "https://github.com/aktehn/mnemo/issues"
  },
  "homepage": "https://github.com/aktehn/mnemo#readme",
  "keywords": [
    "vocabulary",
    "learning",
    "education",
    "spaced-repetition",
    "srs",
    "electron",
    "react",
    "language-learning",
    "flashcards",
    "memorization"
  ],
  "main": "electron/main.cjs",
  "scripts": {
    "dev:react": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "concurrently --success first \"npm run dev:react\" \"npm run dev:electron\"",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "framer-motion": "^12.27.1",
    "fs-extra": "^11.3.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.7.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.mnemo.app",
    "productName": "Mnemo",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/data/**/*",
      "public/**/*",
      "build/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
